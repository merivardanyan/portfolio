# Copy to .env (optional; these are the defaults). Never commit .env.
PORT=8788
HOST=127.0.0.1
DB_FILE=./data/fair-share.sqlite
# Comma-separated allow-list for CORS and WebSocket Origin checks, or *
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies you control in front of the server (0 = ignore X-Forwarded-For).
# The client IP is taken that many hops from the RIGHT of X-Forwarded-For.
TRUST_PROXY=0
# Set to 0 to skip the sample bill on first start
SEED=1
