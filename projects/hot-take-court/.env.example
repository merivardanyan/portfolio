# Copy to .env and adjust. Never commit .env.
APP_ENV=local
# Public base URL used in og:url / og:image and share links (no trailing slash). Required for
# link previews: the Host header is never trusted. If unset, links are relative and og:image is omitted.
APP_URL=http://localhost:8080

# Local: SQLite file (relative to the project root). Created and seeded on first request.
DB_DSN=sqlite:data/hot-take-court.sqlite
DB_USER=
DB_PASS=

# Production (MySQL 8):
# DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=hot_take_court;charset=utf8mb4
# DB_USER=htc_app
# DB_PASS=change-me

# 1 = create + seed the SQLite schema automatically on first request
AUTO_SEED=1
# 1 = force the Secure cookie flag (set when serving over HTTPS behind a proxy)
SESSION_SECURE=0
# Number of reverse proxies you control in front of PHP (0 = ignore X-Forwarded-For).
# The client IP is taken that many hops from the RIGHT of X-Forwarded-For.
TRUST_PROXY=0

# Registrations allowed per IP per hour
REGISTER_LIMIT_PER_HOUR=5

# Optional .ttf paths for the PNG verdict card (og:image). Defaults: DejaVu / Georgia / Consolas if installed.
# CARD_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSerif-Bold.ttf
# CARD_FONT_MONO=/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf
