# Copy to .env (optional; these are the defaults). Never commit .env.
PORT=8787
HOST=127.0.0.1
DB_FILE=./data/hue-hunt.sqlite
# Comma-separated allow-list, or * for any origin
CORS_ORIGIN=http://localhost:5173
# Set to 1 only behind a reverse proxy you control (trust X-Forwarded-For)
TRUST_PROXY=0
SUBMIT_LIMIT_PER_MIN=20
# Set to 0 to skip demo seed data on first start
SEED=1
