# Copy to .env (optional; these are the defaults). Never commit .env.
PORT=8789
HOST=127.0.0.1
# memory | sqlite
STORE=memory
DB_FILE=./data/throttle-lab.sqlite
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=0
# POST /api/config and /api/reset are disabled when NODE_ENV=production unless ALLOW_CONFIG=1
NODE_ENV=development
ALLOW_CONFIG=0
